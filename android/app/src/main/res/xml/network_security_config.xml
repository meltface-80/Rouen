<?xml version="1.0" encoding="utf-8"?>
<!--
  Rouen is plain HTTP on your own network (port 3399): there is no certificate a home server
  could present, so cleartext has to be allowed. As Mandarin's app.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
