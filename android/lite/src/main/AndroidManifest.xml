<?xml version="1.0" encoding="utf-8"?>
<!-- Rouen Lite (dev/design/rouen-lite.md): Rouen's own server, run on this device as the Roon extension. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Roon finds its Core by multicast (SOOD): Android drops multicast to an app without this lock (§3). -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- A server: it runs as a foreground service, with its notification, and keeps the CPU and Wi-Fi awake. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/LiteTheme">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|density|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The server: Node and Rouen in this service's process, for as long as it runs (RouenService.kt). -->
        <service
            android:name=".RouenService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs the Rouen extension for Roon: a server other devices on the network reach." />
        </service>

        <!-- The one copied share card (CardProvider.kt, 2.0.6-t18): read only, not exported, read by the app it is pasted
             into with the clipboard's grant. No permission is asked for. -->
        <provider
            android:name=".CardProvider"
            android:authorities="${applicationId}.card"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
